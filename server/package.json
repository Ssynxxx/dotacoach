{
  "name": "dota-coach-server",
  "version": "1.0.0",
  "description": "REST API untuk Dota Coach AI (Express + Sequelize + OpenDota + Gemini)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageThreshold": { "global": { "statements": 90, "branches": 80, "functions": 90, "lines": 90 } }
  }
}
